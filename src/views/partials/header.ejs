<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <header>
      <div class="site-header">
        <h1 class="site-title">CSE 340 Service Network</h1>
      </div>
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/organizations">Organizations</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/categories">Categories</a></li>
          <% if (isLoggedIn) { %>
            <li><a href="/logout">Logout</a></li>
          <% } else { %>
            <li><a href="/register">Register</a></li>
            <li><a href="/login">Login</a></li>
          <% } %>
        </ul>
      </nav>
    </header>

    <% const messages = flash ? flash() : { success: [], error: [], warning: [], info: [] }; %>
    <% if (messages.success && messages.success.length > 0) { %>
      <div class="flash-messages flash-success">
        <% messages.success.forEach(msg => { %>
          <div class="flash-message"><%= msg %></div>
        <% }); %>
      </div>
    <% } %>
    <% if (messages.error && messages.error.length > 0) { %>
      <div class="flash-messages flash-error">
        <% messages.error.forEach(msg => { %>
          <div class="flash-message"><%= msg %></div>
        <% }); %>
      </div>
    <% } %>
    <% if (messages.warning && messages.warning.length > 0) { %>
      <div class="flash-messages flash-warning">
        <% messages.warning.forEach(msg => { %>
          <div class="flash-message"><%= msg %></div>
        <% }); %>
      </div>
    <% } %>
    <% if (messages.info && messages.info.length > 0) { %>
      <div class="flash-messages flash-info">
        <% messages.info.forEach(msg => { %>
          <div class="flash-message"><%= msg %></div>
        <% }); %>
      </div>
    <% } %>
