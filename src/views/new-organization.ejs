<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="error-summary">
      <h2>Please correct the following errors:</h2>
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>
  <form method="POST" action="/new-organization">
    <div>
      <label for="name">Organization Name:</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= typeof formData !== 'undefined' ? formData.name || '' : '' %>"
        required
      />
    </div>
    <div>
      <label for="description">Description:</label>
      <textarea id="description" name="description" required><%= typeof formData !== 'undefined' ? formData.description || '' : '' %></textarea>
    </div>
    <div>
      <label for="contactEmail">Contact Email:</label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        value="<%= typeof formData !== 'undefined' ? formData.contactEmail || '' : '' %>"
        required
      />
    </div>
    <button type="submit">Create Organization</button>
  </form>
</main>
<%- include('partials/footer') %>
