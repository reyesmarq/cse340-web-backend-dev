<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
  <h2>Dashboard</h2>
  <p>Name: <%= name %></p>
  <p>Username: <%= email %></p>

  <h2>My Volunteer Projects</h2>
  <% if (volunteerProjects.length === 0) { %>
  <p>You are not currently volunteering for any projects.</p>
  <% } else { %>
  <ul>
    <% volunteerProjects.forEach(project => { %>
    <li>
      <a href="/project/<%= project.project_id %>"><%= project.title %></a>
      (<%= project.organization_name %>) —
      <%= new Date(project.project_date).toLocaleDateString('en-US', { year:
      'numeric', month: 'long', day: 'numeric' }) %>
      <form action="/unvolunteer/<%= project.project_id %>" method="POST">
        <input type="hidden" name="returnTo" value="dashboard" />
        <button type="submit">Remove</button>
      </form>
    </li>
    <% }); %>
  </ul>
  <% } %>
</main>
<%- include('partials/footer') %>
